# SmartMed Backend Environment Variables
APP_NAME=SmartMed
APP_ENV=development
PORT=8000
HOST=0.0.0.0

# Database Configuration
# For local MySQL:
DATABASE_URL=mysql+pymysql://root:password@localhost:3306/smartmed?charset=utf8mb4

# For Cloud MySQL (e.g. TiDB Serverless, Aiven, Railway, Render External MySQL):
# DATABASE_URL=mysql+pymysql://<user>:<password>@<host>:<port>/<dbname>?ssl_ca=/etc/ssl/certs/ca-certificates.crt

# JWT Secret & Security
SECRET_KEY=smartmed_super_secure_jwt_secret_key_change_in_production_2026_x89f
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# CORS
CORS_ORIGINS=*

# File Upload Directory
UPLOAD_DIR=../uploads
